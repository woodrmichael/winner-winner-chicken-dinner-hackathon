# Copy to .env and set the values for the workflow you want to run.

# Shared workspace
# COMFORCE_API_HOST=127.0.0.1
# COMFORCE_API_PORT=8787
# COMFORCE_API_DATA=.comforce/workspace.json
# EXPO_PUBLIC_API_URL=http://127.0.0.1:8787

# Server-side integrations
# OPENAI_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_CHECKOUT_RETURN_ORIGIN=https://api.example.org
