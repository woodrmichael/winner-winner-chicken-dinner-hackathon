{
  "name": "comforce-connect",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=24.13.0 <27"
  },
  "scripts": {
    "start": "expo start --go",
    "mobile:lan": "expo start --go --lan",
    "mobile:tunnel": "expo start --go --tunnel",
    "web": "expo start --web",
    "api": "tsx server/start.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "export:web": "expo export --platform web",
    "preview": "serve -s dist -l 4173"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "lucide-react-native": "1.77.0",
    "maplibre-gl": "6.19.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~58.0.0",
    "serve": "^14.2.4",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  }
}
